# ProofRun control-plane config (Class A secrets) — see docs/SPEC.md §11.1
# Copy to /etc/proofrun/control.env on the VM:  sudo install -m 640 -o root -g proofrun control.env.example /etc/proofrun/control.env
# NEVER commit the real file. NEVER pass any of these values into a container (orchestrator/sandbox/env.py enforces this).

# --- Vultr Serverless Inference ---
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
TEXT_MODEL=deepseek-v4.1-flash-1017
TEXT_MODEL_FALLBACK=glm-5.3-flash
VISION_MODEL=nemotron-3-nano-omni-30b-a3b-reasoning
# USD per 1M tokens, from https://api.vultrinference.com/docs/models (re-check before the demo)
PRICE_TEXT_IN=0.15
PRICE_TEXT_OUT=0.60
PRICE_VISION_IN=0.10
PRICE_VISION_OUT=0.25
DAILY_INFERENCE_BUDGET_USD=5
JOB_TOKEN_CAP=60000

# --- GitHub (optional) — fine-grained token, "Public repositories (read-only)"; metadata/size checks only, never passed to fetch ---
GITHUB_TOKEN=

# --- Access control ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
PUBLIC_BASE_URL=https://proofrun.example.com
TRUSTED_PROXY_IPS=127.0.0.1

# --- Keys ---
# Generate with: python3 scripts/keygen.py   (writes the private key 0600 and docs/receipt-public-key.pem)
RECEIPT_SIGNING_KEY_PATH=/etc/proofrun/keys/receipt_ed25519.pem
RECEIPT_KEY_ID=proofrun-2026-11
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=

# --- Sandbox ---
SANDBOX_IMAGE=proofrun-sandbox:latest
# runc by default; set runsc ONLY if the Day-0 gVisor experiment passed
SANDBOX_RUNTIME=runc
MAX_CONCURRENT_JOBS=4
# Mode L live-URL checks run beside the repo slots (web-probe, no slot disk)
MAX_CONCURRENT_LIVE=4
SLOT_ROOT=/var/lib/proofrun/slots
JOB_ROOT=/var/lib/proofrun/jobs
# List price of the plan you actually deployed (used only for labeled cost estimates)
# VX1 vx1-g-8c-32g-480s, Atlanta (D17)
VM_HOURLY_USD=0.306

# --- Public limits ---
RATE_SHOWDOWN_PER_IP_HOUR=3
RATE_DETONATE_PER_IP_HOUR=5
RATE_AUDIT_PER_IP_HOUR=2
AUDIT_DAILY_CAP=30
AUDIT_MAX_REPO_MB=150
